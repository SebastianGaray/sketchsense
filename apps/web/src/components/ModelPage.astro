---
import type { Language } from '../content';

const { lang } = Astro.props as { lang: Language };
const base = import.meta.env.BASE_URL;
const copy =
  lang === 'en'
    ? {
        eyebrow: 'Measured model evidence',
        title: 'Model',
        intro:
          'The released CNN was retrained from official vector strokes and runs entirely in this browser.',
        architecture: 'Widened CNN · 422,608 parameters',
        dataset:
          'Quick, Draw! vector-v3 · 16 classes · 176,000 disjoint samples',
        evaluation: 'Held-out evaluation',
        metrics:
          'Accuracy 94.63% · macro F1 94.61% · top-3 98.76% · worst recall 79.8%',
        charts: 'Training evidence',
        limitations: 'Limitations',
        limitationText:
          'Only 16 categories are supported. The interface abstains on weak or closely matched scores. Confidence remains a model score, not a guarantee.',
        card: 'Read the complete reproducibility record',
      }
    : {
        eyebrow: 'Evidencia medida del modelo',
        title: 'Modelo',
        intro:
          'La CNN publicada se reentrenó desde trazos vectoriales oficiales y se ejecuta completamente en este navegador.',
        architecture: 'CNN ampliada · 422.608 parámetros',
        dataset:
          'Quick, Draw! vector-v3 · 16 clases · 176.000 muestras separadas',
        evaluation: 'Evaluación reservada',
        metrics:
          'Exactitud 94,63 % · F1 macro 94,61 % · top-3 98,76 % · peor recall 79,8 %',
        charts: 'Evidencia de entrenamiento',
        limitations: 'Limitaciones',
        limitationText:
          'Solo se admiten 16 categorías. La interfaz se abstiene ante puntuaciones débiles o muy cercanas. La confianza sigue siendo una puntuación, no una garantía.',
        card: 'Leer el registro completo de reproducibilidad',
      };
---

<section class="secondary-page container" aria-labelledby="model-page-title">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1 id="model-page-title">{copy.title}</h1>
  <p class="page-intro">{copy.intro}</p>
  <dl class="evidence-list">
    <div><dt>sketch-cnn-v3</dt><dd>{copy.architecture}</dd></div>
    <div><dt>vector-v3</dt><dd>{copy.dataset}</dd></div>
    <div><dt>{copy.evaluation}</dt><dd>{copy.metrics}</dd></div>
    <div>
      <dt>ONNX</dt><dd>
        1,707,724 bytes · opset 18 · [1, 1, 28, 28] → logits[16]
      </dd>
    </div>
  </dl>
  <section aria-labelledby="charts-title">
    <h2 id="charts-title">{copy.charts}</h2>
    <div class="model-charts">
      <img src={`${base}evidence/model-comparison.v3.svg`} alt="" />
      <img src={`${base}evidence/per-class-recall.v3.svg`} alt="" />
    </div>
  </section>
  <section class="page-section" aria-labelledby="limitations-title">
    <h2 id="limitations-title">{copy.limitations}</h2>
    <p>{copy.limitationText}</p>
  </section>
  <a
    href="https://github.com/SebastianGaray/sketchsense/blob/main/docs/model-card.md"
    >{copy.card} ↗</a
  >
</section>
