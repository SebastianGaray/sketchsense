---
import type { Language } from '../content';
const { lang } = Astro.props as { lang: Language };
const base = import.meta.env.BASE_URL;
const categories = [
  ['apple', 'manzana'],
  ['bicycle', 'bicicleta'],
  ['bird', 'pájaro'],
  ['book', 'libro'],
  ['car', 'auto'],
  ['cat', 'gato'],
  ['chair', 'silla'],
  ['cloud', 'nube'],
  ['cup', 'taza'],
  ['dog', 'perro'],
  ['fish', 'pez'],
  ['flower', 'flor'],
  ['house', 'casa'],
  ['key', 'llave'],
  ['star', 'estrella'],
  ['tree', 'árbol'],
] as const;
const copy =
  lang === 'en'
    ? {
        back: 'Back to drawing',
        eyebrow: '16 supported categories',
        title: 'What can SketchSense recognize?',
        intro:
          'Each prompt below is a held-out Quick, Draw! sketch that model v3 classifies correctly. Use it as a structural reference, not a tracing template.',
        tips: 'Drawing tips',
        tipItems: [
          'Follow the main silhouette and defining parts shown in the validated prompt.',
          'Make defining parts visible: cat ears, bicycle wheels, cup handle.',
          'Use the normalized preview to check what survives at 28 × 28.',
          'Low confidence means the sketch is ambiguous to this small model.',
        ],
      }
    : {
        back: 'Volver al dibujo',
        eyebrow: '16 categorías disponibles',
        title: '¿Qué puede reconocer SketchSense?',
        intro:
          'Cada referencia es un dibujo reservado de Quick, Draw! que el modelo v3 clasifica correctamente. Úsalo como guía estructural, no como plantilla para calcar.',
        tips: 'Consejos para dibujar',
        tipItems: [
          'Sigue la silueta principal y las partes distintivas de la referencia validada.',
          'Haz visibles las partes distintivas: orejas del gato, ruedas de la bicicleta, asa de la taza.',
          'Revisa la vista normalizada para comprobar qué se conserva a 28 × 28.',
          'Una confianza baja significa que el dibujo es ambiguo para este modelo pequeño.',
        ],
      };
---

<section class="examples-page container" aria-labelledby="examples-title">
  <p class="eyebrow">{copy.eyebrow}</p><h1 id="examples-title">
    {copy.title}
  </h1><p class="examples-intro">
    {copy.intro}
  </p>
  <ul class="category-grid">
    {
      categories.map(([english, spanish]) => (
        <li>
          <>
            <img
              class="category-icon"
              src={`${base}examples/v3/${english}.png`}
              width="112"
              height="112"
              loading="lazy"
              aria-label={lang === 'en' ? english : spanish}
            />
            <strong>{lang === 'en' ? english : spanish}</strong>
            <small>{english}</small>
          </>
        </li>
      ))
    }
  </ul>
  <section class="drawing-tips" aria-labelledby="tips-title">
    <h2 id="tips-title">{copy.tips}</h2><ul>
      {copy.tipItems.map((tip) => <li>{tip}</li>)}
    </ul>
  </section>
</section>
