---
import type { Language } from '../content';

const { lang } = Astro.props as { lang: Language };
const copy =
  lang === 'en'
    ? {
        eyebrow: 'How it works',
        title: 'From stroke to prediction',
        steps: [
          [
            '1. Capture',
            'Freehand pointer strokes remain vector paths, or users can paint the model’s enlarged 28 × 28 pixel grid directly.',
          ],
          [
            '2. Normalize',
            'Vector bounds are centered and antialiased with bounded thickness; pixel mode already is the exact 28 × 28 model input.',
          ],
          [
            '3. Infer',
            'The compact ONNX model runs through WebAssembly on the current device.',
          ],
          [
            '4. Explain',
            'The interface shows the normalized tensor, three ranked predictions, and measured local timings.',
          ],
        ],
        privacy: 'Nothing leaves the browser',
        privacyText: 'Drawings and predictions remain on the current device.',
      }
    : {
        eyebrow: 'Cómo funciona',
        title: 'Del trazo a la predicción',
        steps: [
          [
            '1. Captura',
            'Los trazos libres permanecen como rutas vectoriales, o se puede pintar directamente en la cuadrícula ampliada de 28 × 28.',
          ],
          [
            '2. Normalización',
            'Los límites vectoriales se centran y suavizan con grosor acotado; el modo píxel ya es la entrada exacta de 28 × 28.',
          ],
          [
            '3. Inferencia',
            'El modelo ONNX compacto se ejecuta mediante WebAssembly en el dispositivo actual.',
          ],
          [
            '4. Explicación',
            'La interfaz muestra el tensor normalizado, tres predicciones ordenadas y los tiempos locales medidos.',
          ],
        ],
        privacy: 'Nada sale del navegador',
        privacyText:
          'Los dibujos y las predicciones permanecen en el dispositivo.',
      };
---

<section class="secondary-page container" aria-labelledby="about-page-title">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1 id="about-page-title">{copy.title}</h1>
  <ol class="process-grid">
    {
      copy.steps.map(([title, body]) => (
        <li>
          <>
            <h2>{title}</h2>
            <p>{body}</p>
          </>
        </li>
      ))
    }
  </ol>
  <section class="page-section" aria-labelledby="privacy-title">
    <h2 id="privacy-title">{copy.privacy}</h2>
    <p>{copy.privacyText}</p>
  </section>
</section>
