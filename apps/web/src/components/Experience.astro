---
import type { Language } from '../content';
const { lang } = Astro.props as { lang: Language };
const base = import.meta.env.BASE_URL;
const t =
  lang === 'en'
    ? {
        draw: 'Drawing area',
        clear: 'Clear',
        predict: 'Predict',
        loading: 'Loading the local model…',
        ready: 'Model ready. Draw an object to begin.',
        empty: 'Draw something before requesting a prediction.',
        failed:
          'The model could not load. Check browser WebAssembly support and retry.',
        retry: 'Retry model',
        results: 'Top predictions',
        input: 'Model input',
        inputHelp:
          'The exact centered 28 × 28 grayscale tensor supplied to the model.',
        timing: 'Measured on this device',
        preprocess: 'Preprocessing',
        inference: 'Inference',
        leading: 'Current prediction',
        stroke: 'Stroke width',
        mode: 'Input mode',
        freehand: 'Freehand',
        pixels: '28 × 28 pixels',
      }
    : {
        draw: 'Área de dibujo',
        clear: 'Limpiar',
        predict: 'Predecir',
        loading: 'Cargando el modelo local…',
        ready: 'Modelo listo. Dibuja un objeto para comenzar.',
        empty: 'Dibuja algo antes de solicitar una predicción.',
        failed:
          'No se pudo cargar el modelo. Comprueba la compatibilidad con WebAssembly y reintenta.',
        retry: 'Reintentar modelo',
        results: 'Predicciones principales',
        input: 'Entrada del modelo',
        inputHelp:
          'El tensor exacto de 28 × 28, centrado y en escala de grises, que recibe el modelo.',
        timing: 'Medido en este dispositivo',
        preprocess: 'Preprocesamiento',
        inference: 'Inferencia',
        leading: 'Predicción actual',
        stroke: 'Grosor del trazo',
        mode: 'Modo de entrada',
        freehand: 'Dibujo libre',
        pixels: 'Píxeles 28 × 28',
      };
---

<section
  id="draw"
  class="experience"
  data-experience
  data-lang={lang}
  data-base={base}
  aria-labelledby="workspace-title"
>
  <div class="workspace-heading">
    <p class="eyebrow">
      SketchSense &middot; {
        lang === 'en' ? 'Local inference' : 'Inferencia local'
      }
    </p><h1 id="workspace-title">{t.draw}</h1>
  </div>
  <section class="leading-prediction" aria-labelledby="leading-title">
    <h2 id="leading-title">{t.leading}</h2>
    <p data-leading-prediction aria-live="polite">—</p>
  </section>
  <div class="workspace-grid">
    <div>
      <fieldset class="input-mode" data-input-mode>
        <legend>{t.mode}</legend>
        <label>
          <input
            type="radio"
            name={`input-mode-${lang}`}
            value="freehand"
            checked
          />
          <span>{t.freehand}</span>
        </label>
        <label>
          <input type="radio" name={`input-mode-${lang}`} value="pixels" />
          <span>{t.pixels}</span>
        </label>
      </fieldset>
      <canvas
        data-canvas
        data-input-mode="freehand"
        width="640"
        height="640"
        aria-label={t.draw}></canvas>
      <div class="drawing-tools" data-stroke-control>
        <label for={`stroke-width-${lang}`}>{t.stroke}</label>
        <input
          id={`stroke-width-${lang}`}
          data-stroke-width
          type="range"
          min="8"
          max="32"
          step="2"
          value="14"
        />
        <output data-stroke-output for={`stroke-width-${lang}`}>14 px</output>
      </div>
      <div class="actions">
        <button class="secondary" data-clear disabled>{t.clear}</button><button
          class="primary"
          data-predict
          disabled>{t.predict}</button
        >
      </div>
    </div>
    <aside class="evidence-rail">
      <div class="status-box">
        <p data-status role="status" aria-live="polite">{t.loading}</p><button
          class="secondary"
          data-retry
          hidden>{t.retry}</button
        >
      </div>
      <section aria-labelledby="results-title">
        <h3 id="results-title">{t.results}</h3><ol
          class="predictions"
          data-results
        >
          <li>—</li>
        </ol>
      </section>
      <section aria-labelledby="input-title">
        <h3 id="input-title">{t.input}</h3><canvas
          class="preview"
          data-preview
          width="28"
          height="28"></canvas><p class="microcopy">{t.inputHelp}</p>
      </section>
      <section aria-labelledby="timing-title">
        <h3 id="timing-title">{t.timing}</h3><dl class="timings">
          <div><dt>{t.preprocess}</dt><dd data-preprocess>—</dd></div><div>
            <dt>{t.inference}</dt><dd data-inference>—</dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>
</section>
<script>
  import { EmptySketchError } from '../lib/preprocessing';
  import { SketchModel } from '../lib/inference';
  import { isUncertain } from '../lib/confidence';
  import {
    normalizePixelGrid,
    normalizeVectorStrokes,
    type StrokePoint,
    type VectorStroke,
  } from '../lib/stroke-preprocessing';
  const root = document.querySelector<HTMLElement>('[data-experience]')!;
  const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
  const preview = root.querySelector<HTMLCanvasElement>('[data-preview]')!;
  const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
  const predict = root.querySelector<HTMLButtonElement>('[data-predict]')!;
  const retry = root.querySelector<HTMLButtonElement>('[data-retry]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const results = root.querySelector<HTMLOListElement>('[data-results]')!;
  const leadingPrediction = root.querySelector<HTMLElement>(
    '[data-leading-prediction]',
  )!;
  const strokeWidth = root.querySelector<HTMLInputElement>(
    '[data-stroke-width]',
  )!;
  const strokeOutput = root.querySelector<HTMLOutputElement>(
    '[data-stroke-output]',
  )!;
  const strokeControl = root.querySelector<HTMLElement>(
    '[data-stroke-control]',
  )!;
  const modeInputs = root.querySelectorAll<HTMLInputElement>(
    '[data-input-mode] input',
  );
  const lang = root.dataset.lang ?? 'en';
  const messages =
    lang === 'en'
      ? {
          loading: 'Loading the local model…',
          ready: 'Model ready. Draw an object to begin.',
          drawn: 'Drawing ready for local prediction.',
          empty: 'Draw something before requesting a prediction.',
          failed:
            'The model could not load. Check browser WebAssembly support and retry.',
          result: 'Prediction complete. Top results are shown.',
          uncertain:
            'Not sure yet. Add more defining details or try a different view.',
        }
      : {
          loading: 'Cargando el modelo local…',
          ready: 'Modelo listo. Dibuja un objeto para comenzar.',
          drawn: 'Dibujo listo para la predicción local.',
          empty: 'Dibuja algo antes de solicitar una predicción.',
          failed:
            'No se pudo cargar el modelo. Comprueba la compatibilidad con WebAssembly y reintenta.',
          result:
            'Predicción completa. Se muestran los resultados principales.',
          uncertain:
            'Aún no estoy seguro. Agrega detalles distintivos o prueba otra vista.',
        };
  const context = canvas.getContext('2d', { willReadFrequently: true })!;
  type InputMode = 'freehand' | 'pixels';
  let inputMode: InputMode = 'freehand';
  let strokes: VectorStroke[] = [];
  const pixelGrid = new Float32Array(28 * 28);
  let currentStroke: { points: StrokePoint[]; width: number } | undefined;
  let previousPixel: StrokePoint | undefined;
  let drawing = false;
  let hasDrawing = false;
  let ready = false;
  let predictionTimer: number | undefined;
  let predictionSequence = 0;
  const model = new SketchModel(root.dataset.base ?? '/sketchsense/');
  const configureFreehandContext = () => {
    context.strokeStyle = '#111';
    context.lineWidth = Number(strokeWidth.value);
    context.lineCap = 'round';
    context.lineJoin = 'round';
  };
  const drawPixelGrid = () => {
    const cell = canvas.width / 28;
    context.fillStyle = '#fff';
    context.fillRect(0, 0, canvas.width, canvas.height);
    context.fillStyle = '#111';
    pixelGrid.forEach((value, index) => {
      if (value <= 0) return;
      context.fillRect(
        (index % 28) * cell,
        Math.floor(index / 28) * cell,
        Math.ceil(cell),
        Math.ceil(cell),
      );
    });
    context.beginPath();
    context.strokeStyle = '#d8d8d8';
    context.lineWidth = 1;
    for (let index = 1; index < 28; index += 1) {
      const position = index * cell;
      context.moveTo(position, 0);
      context.lineTo(position, canvas.height);
      context.moveTo(0, position);
      context.lineTo(canvas.width, position);
    }
    context.stroke();
  };
  const clearSurface = () => {
    context.fillStyle = '#fff';
    context.fillRect(0, 0, canvas.width, canvas.height);
    if (inputMode === 'pixels') drawPixelGrid();
    else configureFreehandContext();
  };
  const resetDrawing = () => {
    window.clearTimeout(predictionTimer);
    predictionSequence += 1;
    strokes = [];
    currentStroke = undefined;
    previousPixel = undefined;
    pixelGrid.fill(0);
    hasDrawing = false;
    clear.disabled = true;
    predict.disabled = true;
    results.innerHTML = '<li>—</li>';
    leadingPrediction.textContent = '—';
    preview.getContext('2d')!.clearRect(0, 0, 28, 28);
    status.textContent = ready ? messages.ready : messages.loading;
    clearSurface();
  };
  clearSurface();
  const load = async () => {
    status.textContent = messages.loading;
    retry.hidden = true;
    try {
      await model.load();
      ready = true;
      predict.disabled = !hasDrawing;
      status.textContent = hasDrawing ? messages.drawn : messages.ready;
    } catch {
      ready = false;
      status.textContent = messages.failed;
      retry.hidden = false;
    }
  };
  const point = (event: PointerEvent) => {
    const box = canvas.getBoundingClientRect();
    return {
      x: ((event.clientX - box.left) * canvas.width) / box.width,
      y: ((event.clientY - box.top) * canvas.height) / box.height,
    };
  };
  const pixelBrushRadius = () =>
    Math.max(0, Math.min(1, Math.round(Number(strokeWidth.value) / 16) - 1));
  const updateStrokeOutput = () => {
    strokeOutput.value =
      inputMode === 'pixels'
        ? `${pixelBrushRadius() * 2 + 1} ${lang === 'en' ? 'cell' : 'celda'}`
        : `${strokeWidth.value} px`;
  };
  const markPixel = (p: StrokePoint) => {
    const x = Math.max(0, Math.min(27, Math.floor((p.x / canvas.width) * 28)));
    const y = Math.max(0, Math.min(27, Math.floor((p.y / canvas.height) * 28)));
    const brushRadius = pixelBrushRadius();
    for (let offsetY = -brushRadius; offsetY <= brushRadius; offsetY += 1) {
      for (let offsetX = -brushRadius; offsetX <= brushRadius; offsetX += 1) {
        const targetX = x + offsetX;
        const targetY = y + offsetY;
        if (targetX >= 0 && targetX < 28 && targetY >= 0 && targetY < 28)
          pixelGrid[targetY * 28 + targetX] = 1;
      }
    }
  };
  const interpolatePixels = (from: StrokePoint, to: StrokePoint) => {
    const distance = Math.max(Math.abs(to.x - from.x), Math.abs(to.y - from.y));
    const steps = Math.max(1, Math.ceil((distance / canvas.width) * 56));
    for (let step = 0; step <= steps; step += 1) {
      const ratio = step / steps;
      markPixel({
        x: from.x + (to.x - from.x) * ratio,
        y: from.y + (to.y - from.y) * ratio,
      });
    }
  };
  const drawingChanged = () => {
    hasDrawing = true;
    clear.disabled = false;
    predict.disabled = !ready;
    status.textContent = messages.drawn;
    schedulePrediction(450);
  };
  canvas.addEventListener('pointerdown', (event) => {
    drawing = true;
    canvas.setPointerCapture(event.pointerId);
    const p = point(event);
    if (inputMode === 'pixels') {
      previousPixel = p;
      markPixel(p);
      drawPixelGrid();
    } else {
      currentStroke = { points: [p], width: Number(strokeWidth.value) };
      strokes.push(currentStroke);
      configureFreehandContext();
      context.beginPath();
      context.moveTo(p.x, p.y);
      context.lineTo(p.x + 0.01, p.y + 0.01);
      context.stroke();
    }
    drawingChanged();
    event.preventDefault();
  });
  canvas.addEventListener('pointermove', (event) => {
    if (!drawing) return;
    const p = point(event);
    if (inputMode === 'pixels') {
      if (previousPixel) interpolatePixels(previousPixel, p);
      previousPixel = p;
      drawPixelGrid();
    } else {
      currentStroke?.points.push(p);
      context.lineTo(p.x, p.y);
      context.stroke();
    }
    drawingChanged();
    event.preventDefault();
  });
  const end = (event: PointerEvent) => {
    if (drawing) {
      drawing = false;
      currentStroke = undefined;
      previousPixel = undefined;
      canvas.releasePointerCapture(event.pointerId);
      schedulePrediction(40);
    }
  };
  canvas.addEventListener('pointerup', end);
  canvas.addEventListener('pointercancel', end);
  strokeWidth.addEventListener('input', () => {
    if (inputMode === 'freehand') configureFreehandContext();
    updateStrokeOutput();
  });
  modeInputs.forEach((input) =>
    input.addEventListener('change', () => {
      if (!input.checked) return;
      inputMode = input.value as InputMode;
      canvas.dataset.inputMode = inputMode;
      strokeControl.hidden = inputMode === 'pixels';
      updateStrokeOutput();
      resetDrawing();
    }),
  );
  clear.addEventListener('click', resetDrawing);
  const runPrediction = async () => {
    if (!ready || !hasDrawing) return;
    const sequence = ++predictionSequence;
    try {
      const started = performance.now();
      const input =
        inputMode === 'pixels'
          ? normalizePixelGrid(pixelGrid)
          : normalizeVectorStrokes(strokes);
      root.querySelector<HTMLElement>('[data-preprocess]')!.textContent =
        `${(performance.now() - started).toFixed(1)} ms`;
      const pixels = preview.getContext('2d')!.createImageData(28, 28);
      input.forEach((value, index) => {
        const shade = 255 - Math.round(value * 255);
        pixels.data[index * 4] = shade;
        pixels.data[index * 4 + 1] = shade;
        pixels.data[index * 4 + 2] = shade;
        pixels.data[index * 4 + 3] = 255;
      });
      preview.getContext('2d')!.putImageData(pixels, 0, 0);
      const infer = performance.now();
      const predictions = await model.predict(input);
      if (sequence !== predictionSequence) return;
      root.querySelector<HTMLElement>('[data-inference]')!.textContent =
        `${(performance.now() - infer).toFixed(1)} ms`;
      results.replaceChildren(
        ...predictions.map((item, index) => {
          const li = document.createElement('li');
          const percent = (item.probability * 100).toFixed(1);
          li.innerHTML = `<div><strong>${index + 1}. ${item.label}</strong><span>${percent}%</span></div><progress max="100" value="${percent}">${percent}%</progress>`;
          return li;
        }),
      );
      const leader = predictions[0];
      leadingPrediction.innerHTML = leader
        ? `<strong>${leader.label}</strong><span>${(leader.probability * 100).toFixed(1)}%</span>`
        : '—';
      status.textContent = isUncertain(predictions)
        ? messages.uncertain
        : messages.result;
    } catch (error) {
      status.textContent =
        error instanceof EmptySketchError ? messages.empty : messages.failed;
    }
  };
  function schedulePrediction(delay: number) {
    window.clearTimeout(predictionTimer);
    if (!ready || !hasDrawing) return;
    predictionTimer = window.setTimeout(() => void runPrediction(), delay);
  }
  predict.addEventListener('click', () => void runPrediction());
  retry.addEventListener('click', load);
  void load();
</script>
