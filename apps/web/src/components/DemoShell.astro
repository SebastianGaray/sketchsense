---
import { content, type Language } from '../content';
import ThemeControl from './ThemeControl.astro';

interface Props {
  lang: Language;
  active: 'draw' | 'examples' | 'model' | 'about' | 'engineering';
  alternatePath?: string;
}

const { lang, active, alternatePath = '' } = Astro.props;
const copy = content[lang];
const alternate = lang === 'en' ? 'es' : 'en';
const base = import.meta.env.BASE_URL;
const navigation =
  lang === 'en'
    ? {
        label: 'Demo pages',
        draw: 'Canvas',
        examples: 'Examples',
        model: 'Model',
        about: 'About',
        engineering: 'Engineering',
      }
    : {
        label: 'Páginas de la demo',
        draw: 'Canvas',
        examples: 'Ejemplos',
        model: 'Modelo',
        about: 'Acerca de',
        engineering: 'Ingeniería',
      };
const links = [
  { key: 'draw', label: navigation.draw, href: `${base}${lang}/` },
  {
    key: 'examples',
    label: navigation.examples,
    href: `${base}${lang}/examples/`,
  },
  { key: 'model', label: navigation.model, href: `${base}${lang}/model/` },
  { key: 'about', label: navigation.about, href: `${base}${lang}/about/` },
  {
    key: 'engineering',
    label: navigation.engineering,
    href: `${base}${lang}/engineering/`,
  },
] as const;
---

<a class="skip-link" href="#main">{copy.skip}</a>
<header class="site-header">
  <div class="container header-primary">
    <a class="brand" href={`${base}${lang}/`} aria-label="SketchSense home"
      >SketchSense</a
    >
    <nav class="desktop-nav" aria-label={navigation.label}>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={active === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <nav
      class="utility-nav"
      aria-label={lang === 'en' ? 'Project controls' : 'Controles del proyecto'}
    >
      <ThemeControl lang={lang} />
      <a
        class="language-switch"
        data-global-control="language"
        href={`${base}${alternate}/${alternatePath}`}
        lang={alternate}
        hreflang={alternate}
        aria-label={copy.language}
      >
        <span class:list={[lang === 'en' && 'active']}>EN</span>
        <span aria-hidden="true">/</span>
        <span class:list={[lang === 'es' && 'active']}>ES</span>
      </a>
      <a
        class="github-mark"
        href="https://github.com/SebastianGaray/sketchsense"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8.7 17.7 3 12l5.7-5.7 1.4 1.4L5.8 12l4.3 4.3-1.4 1.4Zm6.6 0-1.4-1.4 4.3-4.3-4.3-4.3 1.4-1.4L21 12l-5.7 5.7Z"
          ></path>
        </svg>
      </a>
      <details class="project-menu">
        <summary>{lang === 'en' ? 'Menu' : 'Menú'}</summary>
        <div>
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={active === link.key ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
          <a data-portfolio-return href="https://sebastiangaray.github.io/">
            {copy.portfolio}
          </a>
        </div>
      </details>
    </nav>
  </div>
</header>
<main id="main"><slot /></main>
<footer class="site-footer">
  <div class="container footer-shell">
    <div>
      <strong class="footer-brand">SketchSense</strong>
      <small>© {new Date().getFullYear()} Sebastian Garay</small>
    </div>
    <nav aria-label={copy.footerContact}>
      <a href="https://github.com/SebastianGaray/sketchsense">GitHub</a>
      <a href="https://www.linkedin.com/in/sebastián-garay-b28610195/"
        >LinkedIn</a
      >
      <a href="mailto:sebastiangarayperez2@gmail.com">{copy.email}</a>
    </nav>
    <small>{copy.builtWith}</small>
  </div>
</footer>
