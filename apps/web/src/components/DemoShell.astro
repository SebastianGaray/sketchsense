---
import { content, type Language } from '../content';

interface Props {
  lang: Language;
  active: 'draw' | 'examples' | 'model' | 'about';
  alternatePath?: string;
}

const { lang, active, alternatePath = '' } = Astro.props;
const copy = content[lang];
const alternate = lang === 'en' ? 'es' : 'en';
const base = import.meta.env.BASE_URL;
const navigation =
  lang === 'en'
    ? {
        label: 'Demo pages',
        draw: 'Canvas',
        examples: 'Examples',
        model: 'Model',
        about: 'About',
      }
    : {
        label: 'Páginas de la demo',
        draw: 'Canvas',
        examples: 'Ejemplos',
        model: 'Modelo',
        about: 'Acerca de',
      };
const links = [
  { key: 'draw', label: navigation.draw, href: `${base}${lang}/` },
  {
    key: 'examples',
    label: navigation.examples,
    href: `${base}${lang}/examples/`,
  },
  { key: 'model', label: navigation.model, href: `${base}${lang}/model/` },
  { key: 'about', label: navigation.about, href: `${base}${lang}/about/` },
] as const;
---

<a class="skip-link" href="#main">{copy.skip}</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={`${base}${lang}/`} aria-label="SketchSense home"
      >SketchSense</a
    >
    <nav
      aria-label={lang === 'en' ? 'Project controls' : 'Controles del proyecto'}
    >
      <a class="portfolio-link" href="https://sebastiangaray.github.io/"
        >← {copy.portfolio}</a
      >
      <a
        class="language-link"
        href={`${base}${alternate}/${alternatePath}`}
        lang={alternate}>{copy.language}</a
      >
      <a
        class="github-link"
        href="https://github.com/SebastianGaray/sketchsense">GitHub ↗</a
      >
      <div class="theme-control" role="group" aria-label={copy.theme}>
        <button type="button" data-theme-value="system">{copy.system}</button>
        <button type="button" data-theme-value="light">{copy.light}</button>
        <button type="button" data-theme-value="dark">{copy.dark}</button>
      </div>
    </nav>
  </div>
</header>
<nav class="lab-sidebar" aria-label={navigation.label}>
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={active === link.key ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))
  }
</nav>
<main id="main"><slot /></main>
<footer><div class="container">{copy.footer}</div></footer>
<script>
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-theme-value]'),
  ];
  const apply = (preference: string) => {
    const theme =
      preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
    document.documentElement.dataset.themePreference = preference;
    document.documentElement.dataset.theme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#1b1918' : '#fdf8f8');
    buttons.forEach((button) =>
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.themeValue === preference),
      ),
    );
  };
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const value = button.dataset.themeValue ?? 'system';
      if (value === 'system') localStorage.removeItem('sketchsense-theme');
      else localStorage.setItem('sketchsense-theme', value);
      apply(value);
    }),
  );
  media.addEventListener('change', () => {
    if (document.documentElement.dataset.themePreference === 'system')
      apply('system');
  });
  apply(document.documentElement.dataset.themePreference ?? 'system');
</script>
